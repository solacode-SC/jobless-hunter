# ===========================================
# Jobless Hunter — Environment Configuration
# ===========================================

# Application
APP_NAME=Jobless Hunter
APP_ENV=production
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_URL=https://jobs.solaymanbuilds.com

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jobhunter
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=change-me-strong-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# AI Multi-Provider Engine (DeepSeek & Google Gemini with Auto Selection & Failover)
# Provider choices: "auto" (recommended - detects configured keys & auto-fails over), "deepseek", "gemini", "openai"
AI_PROVIDER=auto

# DeepSeek AI (Primary recommended for code & reasoning)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini (Ultra-fast structured evaluation & large context)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# n8n Automation Engine
N8N_HOST=automation.solaymanbuilds.com
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-n8n-password
N8N_ENCRYPTION_KEY=change-me-encryption-key
WEBHOOK_URL=https://automation.solaymanbuilds.com

# Email (Gmail OAuth)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# JWT Authentication
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups

# External Application Ports (Strict 9876-9964 range)
DASHBOARD_PORT=9876
N8N_PORT_EXTERNAL=9877
API_PORT=9878
POSTGRES_PORT_EXTERNAL=9879
REDIS_PORT_EXTERNAL=9880
BROWSER_PORT=9881
MONITORING_PORT=9882
